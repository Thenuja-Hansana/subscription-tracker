# Copy this file to .env.development.local and fill in the values.
# Files ending in .local are ignored by git, so real secrets never get committed.

# Port the API listens on
PORT=3000

# MongoDB Atlas connection string
DB_URI=

# Secret used to sign login tokens. Use any long random text and keep it private.
JWT_SECRET=

# How long a login token stays valid, e.g. 7d for seven days
JWT_EXPIRES_IN=7d

# Arcjet key from app.arcjet.com (starts with ajkey_). Protects the API from bots and abuse.
ARCJET_KEY=

# Tells Arcjet this is your own computer. Remove this line when the API is hosted.
ARCJET_ENV=development

# The Gmail address that sends the reminder emails, and its "app password".
# An app password is 16 letters made at myaccount.google.com/apppasswords. It is not your normal Gmail password.
# While these are empty, reminders are printed in the terminal instead of being emailed.
EMAIL_USER=
EMAIL_PASSWORD=
